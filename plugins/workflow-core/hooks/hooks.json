{
  "description": "执行轨迹（默认关闭）：用户运行 /workflow-core:trace on 后，把工具调用事件写入本机日志供实时页面展示；关闭时立即退出",
  "hooks": {
    "UserPromptSubmit": [{"hooks": [{"type": "command", "command": "python3", "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/trace_hook.py"], "async": true}]}],
    "UserPromptExpansion": [{"hooks": [{"type": "command", "command": "python3", "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/trace_hook.py"], "async": true}]}],
    "PreToolUse": [{"hooks": [{"type": "command", "command": "python3", "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/trace_hook.py"], "async": true}]}],
    "PostToolUse": [{"hooks": [{"type": "command", "command": "python3", "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/trace_hook.py"], "async": true}]}],
    "PostToolUseFailure": [{"hooks": [{"type": "command", "command": "python3", "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/trace_hook.py"], "async": true}]}],
    "Stop": [{"hooks": [{"type": "command", "command": "python3", "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/trace_hook.py"], "async": true}]}]
  }
}
