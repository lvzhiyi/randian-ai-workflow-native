{
  "description": "始终启用的同步任务流程门禁；受支持路径拒绝未授权写入，非可信签署",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "WORKFLOW_HOST=codex python3 \"${PLUGIN_ROOT}/scripts/workflow_gate.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "WORKFLOW_HOST=codex python3 \"${PLUGIN_ROOT}/scripts/workflow_gate.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "WORKFLOW_HOST=codex python3 \"${PLUGIN_ROOT}/scripts/workflow_gate.py\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "WORKFLOW_HOST=codex python3 \"${PLUGIN_ROOT}/scripts/workflow_gate.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "WORKFLOW_HOST=codex python3 \"${PLUGIN_ROOT}/scripts/workflow_gate.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
